<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(organization => { %>
                <li>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>: <%= organization.contact_email %>
                </li>
            <% }); %>
        <% } else { %>
            <p>No partner organizations configured yet.</p>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>