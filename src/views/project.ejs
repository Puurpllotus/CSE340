<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>
    
    <div class="project-details">
        <p class="project-organization">
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        
        <p class="project-date">
            <strong>Date:</strong> 
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        
        <p class="project-location"><strong>Location:</strong> <%= project.location %></p>
        
        <p class="project-description"><strong>Description:</strong> <%= project.description %></p>
        
        <div class="project-tags">
            <strong>Categories:</strong>
            <% if (categories && categories.length > 0) { %>
                <div class="tags-list">
                    <% categories.forEach(category => { %>
                        <a href="/category/<%= category.category_id %>" class="tag-badge"><%= category.name %></a>
                    <% }) %>
                </div>
            <% } else { %>
                <span>Uncategorized</span>
            <% } %>
        </div>
    </div>

    <div class="volunteer-section" style="margin-top: 30px; padding: 20px; border-radius: 6px; background-color: #fcfcfc; border: 1px solid #e2e8f0;">
        <% if (locals.session && locals.session.user) { %>
            <% if (isVolunteering) { %>
                <div class="status-alert" style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 12px; margin-bottom: 15px;">
                    <p style="color: #166534; font-weight: 600; margin: 0;">✓ You are volunteering for this project!</p>
                </div>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn btn-danger" style="background-color: #dc2626; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: 500;">
                        Remove Myself as a Volunteer
                    </button>
                </form>
            <% } else { %>
                <p style="margin-top: 0; color: #475569;">Would you like to support this initiative? Click below to sign up as a volunteer:</p>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn btn-primary" style="background-color: #2563eb; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: 600;">
                        Volunteer for this Project
                    </button>
                </form>
            <% } %>
        <% } else { %>
            <p style="margin: 0; color: #64748b; font-style: italic;">
                Please <a href="/login" style="color: #2563eb; text-decoration: underline;">log in</a> to view volunteer opportunities for this project.
            </p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>