<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>
    
    <div class="project-details">
        <p class="project-organization">
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        
        <p class="project-date">
            <strong>Date:</strong> 
            <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        </p>
        
        <p class="project-location"><strong>Location:</strong> <%= project.location %></p>
        
        <p class="project-description"><strong>Description:</strong> <%= project.description %></p>
        
        <div class="project-tags">
            <strong>Categories:</strong>
            <% if (categories && categories.length > 0) { %>
                <div class="tags-list">
                    <% categories.forEach(category => { %>
                        <a href="/category/<%= category.category_id %>" class="tag-badge"><%= category.name %></a>
                    <% }) %>
                </div>
            <% } else { %>
                <span>Uncategorized</span>
            <% } %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>